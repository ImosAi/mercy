# config/autopsy.yaml.example
# Kopyalayıp config/autopsy.yaml olarak kaydet

llm:
  provider: openai
  model: gpt-4o
  api_key: "your-api-key-here"
  temperature: 0.1

input:
  source: mock  # mock, sentry, github
  webhook_url: "https://example.com/webhook"

git:
  repo_path: "/tmp/autopsy-test-repo"  # Lokal bir repo yolu
  base_branch: "main"
  new_branch_prefix: "autopsy-fix-"

test:
  runner: pytest
  test_path: "tests/"
  command: "pytest {test_path} --quiet"

pr:
  title_prefix: "[Autopsy] Fix: "
  description_template: |
    This PR was automatically generated by Autopsy.
    **LLM Analysis:**
    {analysis}

    **Proposed Patch:**
    ```diff
    {patch}
    ```

    **Tests Run:**
    - Status: {test_status}
    - Output: {test_output}
  reviewers:
    - "developer1"
    - "developer2"

language:
  input: auto
  output: en
